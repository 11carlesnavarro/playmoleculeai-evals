# Copy to .env. `make run` exports it, and job files read it as ${VAR}.
OPENAI_API_KEY=
FIREWORKS_API_KEY=
ANTHROPIC_API_KEY=          # the judge (pmai_evals/judge.py)

# Phase 4 and later: the eval account on the dev backend (user carles)
PM_BACKEND_URL=http://computer19.acellera.lan:8002
PM_EMAIL=
PM_PASSWORD=
# Phase 5: the site that the viewer sidecar opens; PM_EMAIL must log in there.
# dev.acellera.playmolecule.ai serves the PMView source (Vite dev server): it can change during a run.
PMVIEW_URL=https://acellera.playmolecule.ai

# Phase 6: PlayMolecule jobs
BACKEND_SERVICE_TOKEN=
PM_EVAL_BUCKET=             # host path of the eval user's bucket
