# Copy to .env. `make run` exports it, and job files read it as ${VAR}.
OPENAI_API_KEY=             # the agent (all evals) and the judge (judge.py)

# viewer cases: a PlayMolecule account that logs in on PMVIEW_URL (its profile needs a country)
PM_EMAIL=
PM_PASSWORD=
# the site that the viewer sidecar opens. dev.acellera.playmolecule.ai serves the PMView source
# (Vite dev server), so it can change during a run.
PMVIEW_URL=https://acellera.playmolecule.ai
